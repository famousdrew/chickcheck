# Database - Railway will provide this automatically when you add PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/chickcheck?schema=public"

# Auth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Railway will automatically set these in production:
# - PORT (defaults to 3000)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PUBLIC_DOMAIN

# Optional OAuth (configure in Railway dashboard)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob Storage (for chick photos)
# Get from: vercel.com/dashboard/stores → Create → Blob
BLOB_READ_WRITE_TOKEN=""

# Password reset emails (https://resend.com)
# Without RESEND_API_KEY, reset emails are written to the server log instead.
RESEND_API_KEY=""
# Must be a sender on a domain verified in Resend
EMAIL_FROM="ChickCheck <noreply@yourdomain.com>"
# Public URL used in emailed links. Defaults to NEXTAUTH_URL, then
# https://$RAILWAY_PUBLIC_DOMAIN.
APP_URL=""

# Push reminders (Web Push). Generate a key pair once with: npm run vapid
# Changing the keys later invalidates every existing subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, as mailto: or https: URL
VAPID_SUBJECT="mailto:you@example.com"
# The server sends due reminders every 15 minutes. Set to "off" to disable.
# REMINDER_SCHEDULER="off"
# Optional: lets an external scheduler call POST /api/cron/reminders
# with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""
